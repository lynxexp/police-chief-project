{
  "name": "police-chief-webapp-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Web dashboard backend for the Police Chief Discord bot. Reads/writes the same SQLite files under db/ that the Python bot uses.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/csrf-protection": "^7.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/static": "^10.1.3",
    "adm-zip": "^0.6.0",
    "archiver": "^8.0.0",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.2.1",
    "fastify-plugin": "^6.0.0",
    "kysely": "^0.29.5"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/archiver": "^8.0.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
