# Copy to .env for local `npm run dev` use. In Docker Compose, these are
# set directly via `environment:` instead (see docker/docker-compose.yml)
# -- this file is dev convenience only, never read in production.

PORT=3000

# Path to the bot's db/ folder. Defaults to ../../db (repo-root db/) when
# unset, which works if you run `npm run dev` from webapp/backend/ against
# a checked-out copy of the bot repo. Point this at a COPY of db/, not the
# live one, while developing.
BOT_DB_DIR=

# Where webapp.sqlite (sessions) is created. Defaults to ./db.
WEBAPP_DB_DIR=

# From the SAME Discord Application the bot token belongs to -- add an
# OAuth2 redirect URI there matching DISCORD_REDIRECT_URI below, and
# generate a Client Secret. No new Discord application needed.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Generate once (e.g. `openssl rand -base64 32`) and keep stable -- signs
# both the session cookie and the short-lived OAuth PKCE cookie.
SESSION_SECRET=

# Stays false until a reverse proxy (Caddy) is actually in front of this
# app. See the plan doc's Docker Compose growth path.
TRUST_PROXY=false
